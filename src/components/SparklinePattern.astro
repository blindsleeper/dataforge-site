---
// Tiled sparkline texture + legibility gradient, for header bands.
// Drop inside a `position: relative; overflow: hidden;` container, before
// the content layer. `id` only needs to be unique within the page it's on.
export interface Props {
  id?: string;
}
const { id = 'sparkline-pattern' } = Astro.props;
---
<svg width="0" height="0" class="sparkline-defs" aria-hidden="true">
  <defs>
    <pattern id={id} width="110" height="40" patternUnits="userSpaceOnUse">
      <path d="M0,28 L14,10 L28,24 L42,6 L56,20 L70,14 L84,26 L98,8 L110,20" fill="none" stroke="currentColor" stroke-width="1.3" opacity="0.35" />
    </pattern>
  </defs>
</svg>
<svg class="sparkline-strip" aria-hidden="true"><rect width="100%" height="100%" fill={`url(#${id})`} /></svg>
<div class="sparkline-overlay"></div>
