---
import Layout from '../layouts/Layout.astro';

const writeups = [
  {
    slug:     'it-triage',
    eyebrow:  '// Write-Up',
    category: 'Systems & Automation',
    title:    'When Nobody Owns IT: Building a Triage System for a Professional Office',
    excerpt:  "Most small professional offices don't have an IT department — they have whoever is least busy when something breaks. This is the story of replacing that with a lightweight triage system that actually stuck: why the problem was harder than it looked, what I built, and what running it in a real environment taught me.",
    tags:     ['Python', 'Flask', 'SQLite', 'Internal Tooling'],
    readTime: '6 min read',
    href:     '/work/it-triage',
  },
];
---

<Layout title="Work">

<!-- ── PAGE HERO ── -->
<section class="page-hero">
  <div class="page-hero-grid"></div>
  <div class="page-hero-glow"></div>
  <div class="page-hero-inner">
    <div class="page-eyebrow fade-up d1">// Work & Process</div>
    <h1 class="page-headline fade-up d2">
      Work &amp;<br><em>Process</em>
    </h1>
    <p class="page-sub fade-up d3">
      A look at how I approach real problems — the thinking, the tools, and the outcomes.
    </p>
  </div>
</section>

<!-- ── WRITE-UPS ── -->
<div style="border-bottom: 1px solid var(--border);">
  <div class="section">
    <div class="section-header">
      <span class="section-num">01</span>
      <h2 class="section-title">Field<br><em>Notes</em></h2>
    </div>
    <div class="section-rule"></div>

    <div class="writeups-grid">
      {writeups.map((w) => (
        <article class="writeup-card fade-up d2">
          <div class="writeup-accent-bar"></div>

          <div class="writeup-header">
            <span class="writeup-eyebrow">{w.eyebrow}</span>
            <span class="writeup-category">{w.category}</span>
          </div>

          <div class="writeup-body">
            <h3 class="writeup-title">{w.title}</h3>
            <p class="writeup-excerpt">{w.excerpt}</p>

            <div class="writeup-footer">
              <div class="writeup-meta">
                <div class="writeup-tags">
                  {w.tags.map((t) => (
                    <span class="tag">{t}</span>
                  ))}
                </div>
                <span class="writeup-read-time">{w.readTime}</span>
              </div>
              <a href={w.href} class="writeup-cta">
                Read Write-Up <span class="cta-arrow">→</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <p class="writeups-note">
      More write-ups are in draft. These aren't case studies — they're honest accounts of the work.
    </p>
  </div>
</div>

<!-- ── CTA ── -->
<div class="cta-strip">
  <div class="cta-glow"></div>
  <div class="cta-eyebrow">// Have a Problem Worth Solving?</div>
  <h2 class="cta-headline">Let's Figure<br><em>It Out.</em></h2>
  <p class="cta-sub">
    Discovery calls are free and take 30 minutes. Come with a problem — leave knowing whether I'm the right fit.
  </p>
  <div class="cta-actions">
    <a href="/contact" class="btn-primary">Start a Conversation</a>
    <a href="/portfolio" class="btn-ghost">View Portfolio</a>
  </div>
</div>

</Layout>

<style>
  /* ── PAGE HERO ── */
  .page-hero {
    min-height: 46vh;
    padding-top: var(--nav-h);
    display: flex; align-items: center;
    position: relative; overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .page-hero-grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 90% 80% at 50% 50%, black 20%, transparent 100%);
    pointer-events: none;
  }
  .page-hero-glow {
    position: absolute; top: -10%; right: 5%;
    width: 700px; height: 500px;
    background: radial-gradient(ellipse, rgba(232,146,10,0.055) 0%, transparent 65%);
    pointer-events: none;
  }
  .page-hero-inner {
    position: relative; z-index: 2;
    max-width: 1200px; margin: 0 auto;
    padding: 80px 48px; width: 100%;
  }
  .page-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--accent); margin-bottom: 20px;
  }
  .page-headline {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 900; font-size: clamp(64px, 8vw, 100px);
    line-height: 0.9; letter-spacing: -0.01em;
    text-transform: uppercase; color: var(--text);
    margin-bottom: 28px;
  }
  .page-headline em { font-style: normal; color: var(--accent); display: block; }
  .page-sub {
    font-size: 16px; line-height: 1.7; color: var(--muted);
    max-width: 520px;
  }

  /* ── WRITE-UP CARDS ── */
  .writeups-grid {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    margin-bottom: 40px;
  }

  .writeup-card {
    background: var(--bg3);
    position: relative;
    transition: background 0.3s;
  }
  .writeup-card:hover { background: var(--bg4); }

  .writeup-accent-bar {
    position: absolute; top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), var(--accent2) 40%, transparent);
  }

  .writeup-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 28px 40px 0;
    flex-wrap: wrap; gap: 8px;
  }
  .writeup-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--muted);
  }
  .writeup-category {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--accent);
    padding: 4px 12px;
    border: 1px solid var(--adim3);
    background: var(--adim);
  }

  .writeup-body {
    padding: 28px 40px 36px;
  }
  .writeup-title {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800; font-size: clamp(26px, 3vw, 38px);
    letter-spacing: 0.01em; text-transform: uppercase;
    color: var(--text); line-height: 1.05;
    margin-bottom: 20px; max-width: 780px;
  }
  .writeup-excerpt {
    font-size: 14px; line-height: 1.8; color: var(--muted);
    max-width: 680px; margin-bottom: 36px;
  }

  .writeup-footer {
    display: flex; align-items: center;
    justify-content: space-between; gap: 20px;
    flex-wrap: wrap;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .writeup-meta {
    display: flex; align-items: center; gap: 20px; flex-wrap: wrap;
  }
  .writeup-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .writeup-read-time {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--muted2); white-space: nowrap;
  }

  .writeup-cta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--accent); text-decoration: none; white-space: nowrap;
    display: inline-flex; align-items: center; gap: 6px;
    transition: color 0.2s;
  }
  .writeup-cta:hover { color: var(--accent2); }
  .cta-arrow { transition: transform 0.2s; display: inline-block; }
  .writeup-cta:hover .cta-arrow { transform: translateX(3px); }

  .writeups-note {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; letter-spacing: 0.06em; line-height: 1.7;
    color: var(--muted2);
  }

  /* ── CTA STRIP ── */
  .cta-strip {
    padding: 100px 48px; text-align: center;
    position: relative; overflow: hidden; background: var(--bg);
  }
  .cta-glow {
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 800px; height: 400px;
    background: radial-gradient(ellipse, rgba(232,146,10,0.06) 0%, transparent 60%);
    pointer-events: none;
  }
  .cta-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--accent); margin-bottom: 20px; position: relative; z-index: 1;
  }
  .cta-headline {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 900; font-size: clamp(48px, 6vw, 80px);
    line-height: 0.92; text-transform: uppercase;
    color: var(--text); margin-bottom: 20px; position: relative; z-index: 1;
  }
  .cta-headline em { font-style: normal; color: var(--accent); display: block; }
  .cta-sub {
    font-size: 15px; color: var(--muted); margin-bottom: 44px;
    max-width: 440px; margin-inline: auto; line-height: 1.7;
    position: relative; z-index: 1;
  }
  .cta-actions {
    display: flex; gap: 16px; justify-content: center;
    align-items: center; flex-wrap: wrap; position: relative; z-index: 1;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .page-hero-inner { padding: 60px 24px; }
    .writeup-header { padding: 24px 24px 0; }
    .writeup-body { padding: 20px 24px 28px; }
    .writeup-footer { flex-direction: column; align-items: flex-start; }
    .cta-strip { padding: 80px 24px; }
  }
</style>
