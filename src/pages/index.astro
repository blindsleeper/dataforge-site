---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Small Business Web Developer" description="Small business web developer and technology consultant in Wichita, KS. Website design and development you can edit yourself, plus automation, analytics, and law firm tools.">

<!-- HERO -->
<section class="hero">
  <picture class="hero-photo-wrap">
    <source media="(min-width: 641px)" srcset="/images/graphics/hero-workspace.webp" width="1672" height="941" />
    <img class="hero-photo" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" aria-hidden="true" width="1672" height="941" decoding="async" fetchpriority="high" />
  </picture>
  <div class="hero-photo-fade"></div>
  <div class="hero-glow"></div>
  <canvas id="network-canvas" class="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-inner">
    <div class="hero-left">
      <div class="hero-eyebrow fade-up d1">Wichita, KS — Small Business Web Developer</div>
      <h1 class="hero-headline fade-up d2">
        Your Data.<br>
        <em>Your Edge.</em>
      </h1>
      <p class="hero-sub fade-up d3">
        DataForge designs and builds <strong>small business websites</strong> that are fast, mobile-first,
        and easy for you to edit. I also build automation, analytics dashboards, and tools for law firms.
      </p>
      <div class="hero-actions fade-up d4">
        <a href="/contact/" class="btn-primary">Start a Project</a>
        <a href="/portfolio/" class="btn-ghost">See My Work</a>
      </div>
    </div>
  </div>
</section>

<!-- TRUST BAR -->
<div class="trust-bar">
  <div class="trust-item"><span class="trust-dot"></span>Wichita, KS Based</div>
  <div class="trust-item"><span class="trust-dot"></span>Web & CMS</div>
  <div class="trust-item"><span class="trust-dot"></span>Webflow & Custom Code</div>
  <div class="trust-item"><span class="trust-dot"></span>Automation</div>
  <div class="trust-item"><span class="trust-dot"></span>Data Analytics</div>
</div>

<!-- SERVICES -->
<div id="services" style="border-bottom: 1px solid var(--border);">
  <div class="section">
    <div class="section-header reveal">
      <span class="section-num">01</span>
      <h2 class="section-title">What I<br><em>Do</em></h2>
    </div>
    <div class="section-rule"></div>
    <div class="services-grid services-grid--row">
      <div class="service-card service-card--row reveal">
        <img class="row-art" src="/images/graphics/glass-web.webp" alt="Illustration of a website in a browser window" width="800" height="800" loading="lazy" decoding="async" />
        <div class="service-name">Web & CMS</div>
        <div class="service-desc">Small business website design and web development, hand-coded or on Webflow.</div>
        <a href="/services/" class="service-arrow" style="text-decoration:none;" aria-label="See Web &amp; CMS on Services">↗</a>
      </div>
      <div class="service-card service-card--row reveal">
        <img class="row-art" src="/images/graphics/glass-automation.webp" alt="Illustration of a browser window showing a gear connected to four boxes" width="800" height="800" loading="lazy" decoding="async" />
        <div class="service-name">Systems & Automation</div>
        <div class="service-desc">Business systems consultant in Wichita: small business process automation, often cheaper than off-the-shelf CRM software.</div>
        <a href="/services/" class="service-arrow" style="text-decoration:none;" aria-label="See Systems &amp; Automation on Services">↗</a>
      </div>
      <div class="service-card service-card--row reveal">
        <img class="row-art" src="/images/graphics/glass-analytics.webp" alt="Illustration of a browser window showing a growing bar chart" width="800" height="800" loading="lazy" decoding="async" />
        <div class="service-name">Data Analytics</div>
        <div class="service-desc">Small business data analytics consulting: dashboards and reporting that drive decisions.</div>
        <a href="/services/" class="service-arrow" style="text-decoration:none;" aria-label="See Data Analytics on Services">↗</a>
      </div>
      <div class="service-card service-card--row reveal">
        <img class="row-art" src="/images/graphics/glass-ai.webp" alt="Illustration of a browser window showing a connected workflow with an AI sparkle" width="800" height="800" loading="lazy" decoding="async" />
        <div class="service-name">AI-Augmented Workflows</div>
        <div class="service-desc">AI tools for document analysis, content generation, and decision support.</div>
        <a href="/services/" class="service-arrow" style="text-decoration:none;" aria-label="See AI-Augmented Workflows on Services">↗</a>
      </div>
    </div>
    <div class="services-grid services-grid--2col" style="margin-top:24px;">
      <div class="service-card reveal">
        <div class="service-name">Small Business Website Design in Wichita</div>
        <div class="service-desc">Custom or Webflow websites you can edit yourself, built by one local developer.</div>
        <a href="/small-business-website-design-wichita/" class="btn-primary" style="display:inline-block;">See Website Design in Wichita →</a>
      </div>
      <div class="service-card reveal">
        <div class="service-name">Law Firm Technology Consulting in Wichita</div>
        <div class="service-desc">IT issue tracking, reporting dashboards, and websites for law firms. CaseLens and the Evidence Processing Suite (working name) are in development.</div>
        <a href="/law-firm-technology-consulting-wichita/" class="btn-primary" style="display:inline-block;">See Law Firm Technology Consulting →</a>
      </div>
    </div>
    <div style="margin-top:32px;text-align:right;">
      <a href="/services/" class="btn-ghost">View All Services + Pricing →</a>
    </div>
  </div>
</div>

<!-- SELECTED WORK -->
<div style="background:var(--bg2);border-bottom: 1px solid var(--border);">
  <div class="section">
    <div class="section-header reveal">
      <span class="section-num">02</span>
      <h2 class="section-title">Selected<br><em>Work</em></h2>
    </div>
    <div class="section-rule"></div>
    <div class="services-grid">
      <div class="service-card reveal">
