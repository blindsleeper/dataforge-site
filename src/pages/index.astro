<!-- CTA STRIP -->
<div style="background:var(--bg2);border-bottom:1px solid var(--border);padding:100px 48px;text-align:center;position:relative;overflow:hidden;">
  <picture class="cta-backdrop-wrap">
    <source media="(min-width: 641px)" srcset="/images/graphics/glow-backdrop-subtle.webp" width="1280" height="720" />
    <img class="cta-backdrop" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" aria-hidden="true" width="1280" height="720" decoding="async" />
  </picture>
  <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:800px;height:400px;background:radial-gradient(ellipse,rgba(232,146,10,0.06) 0%,transparent 60%);pointer-events:none;"></div>
  <div style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:var(--accent);margin-bottom:20px;position:relative;z-index:1;">// Ready to Build</div>
  <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:clamp(48px,6vw,80px);line-height:0.92;text-transform:uppercase;color:var(--text);margin-bottom:20px;position:relative;z-index:1;">Forge Your<br>Competitive Edge.</h2>
  <p style="font-size:16px;color:var(--muted);margin-bottom:44px;position:relative;z-index:1;">A free 30-minute intake call. I'll define the problem and figure out if there's a fit.</p>
  <div style="display:flex;gap:16px;justify-content:center;align-items:center;flex-wrap:wrap;position:relative;z-index:1;">
    <a href="/contact/" class="btn-primary">Start a Project</a>
  </div>
</div>

</Layout>

<style>
  .hero {
    padding-top: calc(var(--nav-h) + 100px); padding-bottom: 100px;
    position: relative; overflow: hidden;
  }
  .hero::before {
    content: ''; position: absolute; inset: 0;
    background-image: linear-gradient(var(--border) 1px, transparent 1px), linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, black 30%, transparent 100%);
    pointer-events: none;
  }
  /* Decorative photo anchored right; the fade keeps the dark wall (and the copy) solid on the left. */
  .hero-photo-wrap { display: contents; }
  .hero-photo {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: right center; opacity: 0.8;
    pointer-events: none; z-index: 0;
  }
  .hero-photo-fade {
    position: absolute; inset: 0; pointer-events: none; z-index: 0;
    background:
      linear-gradient(90deg, var(--bg) 0%, var(--bg) 45%, rgba(7,7,7,0.82) 68%, rgba(7,7,7,0.3) 88%, transparent 100%),
      linear-gradient(180deg, var(--bg) 0%, transparent 18%, transparent 80%, var(--bg) 100%);
  }
  .hero-glow { position: absolute; top: 15%; right: -5%; width: 600px; height: 600px; background: radial-gradient(circle, rgba(232,146,10,0.07) 0%, transparent 65%); pointer-events: none; }
  .hero-canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none; }
  .hero-inner { position: relative; z-index: 2; max-width: 1200px; margin: 0 auto; padding: 0 48px; width: 100%; display: grid; grid-template-columns: 1fr; align-items: center; }
  .hero-eyebrow { display: inline-flex; align-items: center; gap: 10px; font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin-bottom: 28px; }
  .hero-eyebrow::before { content: ''; display: block; width: 28px; height: 1px; background: var(--accent); }
  .hero-headline { font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-size: clamp(72px, 8vw, 108px); line-height: 0.9; letter-spacing: -0.01em; text-transform: uppercase; color: var(--text); margin-bottom: 32px; }
  .hero-headline em { font-style: normal; color: var(--accent); display: block; }
  .hero-sub { font-size: 17px; line-height: 1.7; color: var(--muted); margin-bottom: 44px; }
  .hero-sub strong { color: var(--text); font-weight: 500; }
  .hero-actions { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
  .services-grid--2col { grid-template-columns: repeat(2, 1fr); }
  /* "What I Do": a compact four-item row, art above a short name, one line of copy, and a link to Services. */
  .services-grid--row { grid-template-columns: repeat(4, 1fr); }
  .service-card--row { padding: 28px 24px; display: flex; flex-direction: column; }
  .row-art { display: block; width: 96px; height: 96px; margin: 0 0 14px -6px; pointer-events: none; }
  .service-card--row .service-name { font-size: 20px; margin-bottom: 8px; }
  .service-card--row .service-desc { font-size: 13px; line-height: 1.6; margin-bottom: 18px; flex: 1; }
  /* Decorative backdrop behind the closing call-to-action. */
  .cta-backdrop-wrap { display: contents; }
  .cta-backdrop {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; opacity: 0.3; pointer-events: none; z-index: 0;
  }

  /* "How I Work" steps only carry a number + one line of copy, not a
     name/tags/arrow — the default .service-card padding was sized for
     the fuller content, so short text sat stranded in a tall box. */
  .service-card--compact {
    padding: 28px 32px;
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }
  .service-card--compact .service-num {
    position: static;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .service-card--compact .service-desc {
    margin-bottom: 0;
  }

  @media (max-width: 900px) {
    .hero-photo-fade {
      background:
        linear-gradient(90deg, var(--bg) 0%, rgba(7,7,7,0.92) 55%, rgba(7,7,7,0.6) 100%),
        linear-gradient(180deg, var(--bg) 0%, transparent 18%, transparent 80%, var(--bg) 100%);
    }
    .hero-inner { padding: 40px 24px; }
    .services-grid--2col { grid-template-columns: 1fr; }
    .services-grid--row { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .cta-backdrop, .hero-photo, .hero-photo-fade { display: none; }
    .services-grid--row { grid-template-columns: 1fr; }
    .service-card--row {
      display: grid; grid-template-columns: 88px 1fr; column-gap: 18px; align-items: start; padding: 24px;
    }
    .service-card--row .row-art { grid-row: 1 / span 3; width: 88px; height: 88px; margin: 0; }
    .service-card--row .service-desc { margin-bottom: 10px; }
  }
</style>

<script>
  // Animated node network — drifting points behind the hero copy, connected
  // by faint lines when close. Reads --accent from the CSS token itself
  // (not a hardcoded hex) so it stays in sync if the palette ever changes.
  (function () {
    const canvas = document.getElementById('network-canvas');
    if (!(canvas instanceof HTMLCanvasElement)) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function hexToRgb(hex) {
      const n = parseInt(hex.replace('#', ''), 16);
      return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
    }
    const accentHex = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim();
    const [ar, ag, ab] = hexToRgb(accentHex);

    /** @type {{x:number,y:number,vx:number,vy:number}[]} */
    let points = [];

    function size() {
      const r = canvas.parentElement.getBoundingClientRect();
      canvas.width = r.width;
      canvas.height = r.height;
    }

    function seed() {
      // Cap point count on mobile — 55 connection-distance checks per pair
      // adds up fast on the small/slow devices that hit this breakpoint.
      const count = window.innerWidth < 600 ? 25 : 55;
      points = Array.from({ length: count }, () => ({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        vx: (Math.random() - 0.5) * 0.3,
        vy: (Math.random() - 0.5) * 0.3,
      }));
    }

    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      for (let i = 0; i < points.length; i++) {
        for (let j = i + 1; j < points.length; j++) {
          const a = points[i];
          const b = points[j];
          const dist = Math.hypot(a.x - b.x, a.y - b.y);
          if (dist < 130) {
            ctx.strokeStyle = `rgba(${ar},${ag},${ab},${(1 - dist / 130) * 0.35})`;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.stroke();
          }
        }
      }
      for (const p of points) {
        ctx.beginPath();
        ctx.arc(p.x, p.y, 1.6, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${ar},${ag},${ab},0.85)`;
        ctx.fill();
      }
    }

    size();
    seed();
    draw();

    if (reduceMotion) {
      // Freeze on a single static frame — still redraw on resize so it
      // doesn't go stale, but no rAF loop and no drift.
      window.addEventListener('resize', () => { size(); seed(); draw(); });
      return;
    }

    let running = !document.hidden;
    document.addEventListener('visibilitychange', () => { running = !document.hidden; });
    window.addEventListener('resize', size);

    function frame() {
      if (running) {
        for (const p of points) {
          p.x += p.vx;
          p.y += p.vy;
          if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
          if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
        }
        draw();
      }
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  })();
</script>
