        <div class="service-tags"><span class="tag">Python</span><span class="tag">PyQt6</span><span class="tag">Desktop</span></div>
        <a href="/tools/" class="service-arrow" style="text-decoration:none;" aria-label="View SortShelf on Tools">↗</a>
      </div>
      <div class="service-card reveal">
        <span class="service-num">02</span>
        <div class="service-name">IT Logger</div>
