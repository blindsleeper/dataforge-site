---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Data Analytics & Web Consulting">

<!-- HERO -->
<section class="hero">
  <div class="hero-glow"></div>
  <div class="hero-inner">
    <div class="hero-left">
      <div class="hero-eyebrow fade-up d1">Wichita, KS — Data & Web Consulting</div>
      <h1 class="hero-headline fade-up d2">
        Your Data.<br>
        <em>Your Edge.</em>
      </h1>
      <p class="hero-sub fade-up d3">
        DataForge builds the <strong>analytics systems, automated workflows, and web infrastructure</strong>
        that turn raw business data into measurable growth — without the enterprise price tag.
      </p>
      <div class="hero-actions fade-up d4">
        <a href="/contact" class="btn-primary">Start a Project</a>
        <a href="/portfolio" class="btn-ghost">See My Work</a>
      </div>
    </div>
  </div>
</section>

<!-- TRUST BAR -->
<div class="trust-bar">
  <div class="trust-item"><span class="trust-dot"></span>Wichita, KS Based</div>
  <div class="trust-item"><span class="trust-dot"></span>Data Analytics</div>
  <div class="trust-item"><span class="trust-dot"></span>Process Automation</div>
  <div class="trust-item"><span class="trust-dot"></span>Web & CMS</div>
  <div class="trust-item"><span class="trust-dot"></span>AI-Augmented Workflows</div>
</div>

<!-- SERVICES -->
<div id="services" style="border-bottom: 1px solid var(--border);">
  <div class="section">
    <div class="section-header">
      <span class="section-num">01</span>
      <h2 class="section-title">What I<br><em>Build</em></h2>
    </div>
    <div class="section-rule"></div>
    <div class="services-grid services-grid--2col">
      <div class="service-card">
        <div class="service-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 3v18h18M7 16l4-4 4 4 4-8"/></svg>
        </div>
        <span class="service-num">01</span>
        <div class="service-name">Data Analytics</div>
        <div class="service-desc">Transform scattered business data into dashboards and reports that actually drive decisions.</div>
        <div class="service-tags"><span class="tag">Dashboards</span><span class="tag">SQL</span><span class="tag">Reporting</span><span class="tag">KPI Tracking</span></div>
        <span class="service-arrow">↗</span>
      </div>
      <div class="service-card">
        <div class="service-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="1"/><path d="M8 21h8M12 17v4"/></svg>
        </div>
        <span class="service-num">02</span>
        <div class="service-name">Systems & Automation</div>
        <div class="service-desc">Build backend infrastructure that eliminates manual work — custom tools, automated workflows, scalable integrations.</div>
        <div class="service-tags"><span class="tag">Automation</span><span class="tag">Integrations</span><span class="tag">Custom Tools</span><span class="tag">AI Workflows</span></div>
        <span class="service-arrow">↗</span>
      </div>
      <div class="service-card">
        <div class="service-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/></svg>
        </div>
        <span class="service-num">03</span>
        <div class="service-name">Web & CMS</div>
        <div class="service-desc">Professional websites and CMS platforms that convert visitors into clients. Hand-coded or Webflow — built to perform.</div>
        <div class="service-tags"><span class="tag">Webflow</span><span class="tag">Custom Dev</span><span class="tag">CMS</span><span class="tag">Performance</span></div>
        <span class="service-arrow">↗</span>
      </div>
      <div class="service-card">
        <div class="service-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2a7 7 0 0 1 7 7c0 3.5-2 6-5 7v2H10v-2c-3-1-5-3.5-5-7a7 7 0 0 1 7-7z"/><path d="M9 17v2a3 3 0 0 0 6 0v-2"/><path d="M9.5 9.5a2.5 2.5 0 0 1 5 0c0 1.5-1 2.5-2.5 3v1"/></svg>
        </div>
        <span class="service-num">04</span>
        <div class="service-name">AI-Augmented Workflows</div>
        <div class="service-desc">Embed large language models and AI tooling into your existing processes — document analysis, content generation, and decision support.</div>
        <div class="service-tags"><span class="tag">LLM Tools</span><span class="tag">Document Parsing</span><span class="tag">Prompt Engineering</span><span class="tag">Chatbots</span></div>
        <a href="/services" class="service-arrow" style="text-decoration:none;" aria-label="View AI-Augmented Workflows on Services">↗</a>
      </div>
    </div>
    <div style="margin-top:32px;text-align:right;">
      <a href="/services" class="btn-ghost">View All Services + Pricing →</a>
    </div>
  </div>
</div>

<!-- SELECTED WORK -->
<div style="background:var(--bg2);border-bottom: 1px solid var(--border);">
  <div class="section">
    <div class="section-header">
      <span class="section-num">02</span>
      <h2 class="section-title">Selected<br><em>Work</em></h2>
    </div>
    <div class="section-rule"></div>
    <div class="services-grid">
      <div class="service-card">
        <span class="service-num">01</span>
        <div class="service-name">Adams Jones Law Firm</div>
        <div class="service-desc">Webflow Redesign &amp; CMS Buildout — a full site rebuild in Webflow with a structured CMS, a mobile-first layout, and zero developer dependency going forward.</div>
        <div class="service-tags"><span class="tag">Webflow</span><span class="tag">CMS</span><span class="tag">Web Design</span></div>
        <a href="/portfolio" class="service-arrow" style="text-decoration:none;" aria-label="View the Adams Jones project on Portfolio">↗</a>
      </div>
      <div class="service-card">
        <span class="service-num">02</span>
        <div class="service-name">When Nobody Owns IT</div>
        <div class="service-desc">Building a Triage System for a Professional Office — replacing an informal "mention it to whoever's nearby" process with a lightweight triage system that actually stuck. 6 min read.</div>
        <div class="service-tags"><span class="tag">Python</span><span class="tag">Flask</span><span class="tag">SQLite</span></div>
        <a href="/work/it-triage" class="service-arrow" style="text-decoration:none;" aria-label="Read the IT triage write-up">↗</a>
      </div>
    </div>
    <div style="margin-top:32px;text-align:right;">
      <a href="/work" class="btn-ghost">View All Work →</a>
    </div>
  </div>
</div>

<!-- TOOLS I'VE BUILT -->
<div style="border-bottom: 1px solid var(--border);">
  <div class="section">
    <div class="section-header">
      <span class="section-num">03</span>
      <h2 class="section-title">Tools I've<br><em>Built</em></h2>
    </div>
    <div class="section-rule"></div>
    <div class="services-grid">
      <div class="service-card">
        <span class="service-num">01</span>
        <div class="service-name">SortShelf</div>
        <div class="service-desc">A Windows utility that scans a folder, categorizes files by type, previews every move before anything happens, then sorts with one click. Safe by default, with one-step undo.</div>
        <div class="service-tags"><span class="tag">Python</span><span class="tag">PyQt6</span><span class="tag">Desktop</span></div>
        <a href="/tools" class="service-arrow" style="text-decoration:none;" aria-label="View SortShelf on Tools">↗</a>
      </div>
      <div class="service-card">
        <span class="service-num">02</span>
        <div class="service-name">IT Logger</div>
        <div class="service-desc">A lightweight internal ticketing system for environments that won't adopt enterprise helpdesk software. Logs issues, tracks status, and runs locally with zero external dependencies.</div>
        <div class="service-tags"><span class="tag">Flask</span><span class="tag">SQLite</span><span class="tag">Internal</span></div>
        <a href="/tools" class="service-arrow" style="text-decoration:none;" aria-label="View IT Logger on Tools">↗</a>
      </div>
      <div class="service-card">
        <span class="service-num">03</span>
        <div class="service-name">CaseLens</div>
        <div class="service-desc">A desktop tool for reviewing exported case data for legal discovery — browse, search, and filter messages, then export findings to CSV without touching the source data.</div>
        <div class="service-tags"><span class="tag">RC1 — In Development</span><span class="tag">Python</span><span class="tag">PyQt6</span></div>
        <a href="/tools" class="service-arrow" style="text-decoration:none;" aria-label="View CaseLens on Tools">↗</a>
      </div>
    </div>
    <div style="margin-top:32px;text-align:right;">
      <a href="/tools" class="btn-ghost">View All Tools →</a>
    </div>
  </div>
</div>

<!-- HOW I WORK -->
<div style="background:var(--bg2);border-bottom: 1px solid var(--border);">
  <div class="section">
    <div class="section-header">
      <span class="section-num">04</span>
      <h2 class="section-title">How I<br><em>Work</em></h2>
    </div>
    <div class="section-rule"></div>
    <div class="services-grid">
      <div class="service-card">
        <span class="service-num">01</span>
        <div class="service-desc">You send the form or email directly.</div>
      </div>
      <div class="service-card">
        <span class="service-num">02</span>
        <div class="service-desc">I reply within 24 hours with a few targeted questions.</div>
      </div>
      <div class="service-card">
        <span class="service-num">03</span>
        <div class="service-desc">A 30-minute call to assess fit and clarify what I'd need to see.</div>
      </div>
      <div class="service-card">
        <span class="service-num">04</span>
        <div class="service-desc">I review your materials, data, or process documentation.</div>
      </div>
      <div class="service-card">
        <span class="service-num">05</span>
        <div class="service-desc">You receive a written proposal with scope, timeline, and fixed price.</div>
      </div>
    </div>
    <div style="margin-top:32px;text-align:right;">
      <a href="/contact" class="btn-ghost">Start a Project →</a>
    </div>
  </div>
</div>

<!-- CTA STRIP -->
<div style="background:var(--bg2);border-bottom:1px solid var(--border);padding:100px 48px;text-align:center;position:relative;overflow:hidden;">
  <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:800px;height:400px;background:radial-gradient(ellipse,rgba(232,146,10,0.06) 0%,transparent 60%);pointer-events:none;"></div>
  <div style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:var(--accent);margin-bottom:20px;position:relative;z-index:1;">// Ready to Build</div>
  <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:clamp(48px,6vw,80px);line-height:0.92;text-transform:uppercase;color:var(--text);margin-bottom:20px;position:relative;z-index:1;">Forge Your<br>Competitive Edge.</h2>
  <p style="font-size:16px;color:var(--muted);margin-bottom:44px;position:relative;z-index:1;">A free 30-minute call. I'll define the problem and figure out if there's a fit.</p>
  <div style="display:flex;gap:16px;justify-content:center;align-items:center;flex-wrap:wrap;position:relative;z-index:1;">
    <a href="/contact" class="btn-primary">Start a Project</a>
  </div>
</div>

</Layout>

<style>
  .hero {
    padding-top: calc(var(--nav-h) + 100px); padding-bottom: 100px;
    position: relative; overflow: hidden;
  }
  .hero::before {
    content: ''; position: absolute; inset: 0;
    background-image: linear-gradient(var(--border) 1px, transparent 1px), linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, black 30%, transparent 100%);
    pointer-events: none;
  }
  .hero-glow { position: absolute; top: 15%; right: -5%; width: 600px; height: 600px; background: radial-gradient(circle, rgba(232,146,10,0.07) 0%, transparent 65%); pointer-events: none; }
  .hero-inner { position: relative; z-index: 2; max-width: 1200px; margin: 0 auto; padding: 0 48px; width: 100%; display: grid; grid-template-columns: 1fr; align-items: center; }
  .hero-eyebrow { display: inline-flex; align-items: center; gap: 10px; font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin-bottom: 28px; }
  .hero-eyebrow::before { content: ''; display: block; width: 28px; height: 1px; background: var(--accent); }
  .hero-headline { font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-size: clamp(72px, 8vw, 108px); line-height: 0.9; letter-spacing: -0.01em; text-transform: uppercase; color: var(--text); margin-bottom: 32px; }
  .hero-headline em { font-style: normal; color: var(--accent); display: block; }
  .hero-sub { font-size: 17px; line-height: 1.7; color: var(--muted); margin-bottom: 44px; }
  .hero-sub strong { color: var(--text); font-weight: 500; }
  .hero-actions { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
  .services-grid--2col { grid-template-columns: repeat(2, 1fr); }
  @media (max-width: 900px) {
    .hero-inner { padding: 40px 24px; }
    .services-grid--2col { grid-template-columns: 1fr; }
  }
</style>
