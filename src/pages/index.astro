        <div class="service-tags"><span class="tag">Flask</span><span class="tag">SQLite</span><span class="tag">Internal</span></div>
        <a href="/tools/" class="service-arrow" style="text-decoration:none;" aria-label="View IT Logger on Tools">↗</a>
      </div>
      <div class="service-card reveal">
        <span class="service-num">03</span>
        <div class="service-name">CaseLens</div>
        <div class="service-desc">In development: a desktop tool for reviewing exported case data for legal discovery — browse, search, and filter messages, then export findings to CSV without touching the source data.</div>
        <div class="service-tags"><span class="tag">RC1 — In Development</span><span class="tag">Python</span><span class="tag">PyQt6</span></div>
        <a href="/tools/" class="service-arrow" style="text-decoration:none;" aria-label="View CaseLens on Tools">↗</a>
      </div>
    </div>
    <div style="margin-top:32px;text-align:right;">
      <a href="/tools/" class="btn-ghost">View All Tools →</a>
    </div>
