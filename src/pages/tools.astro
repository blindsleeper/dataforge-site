---
import Layout from '../layouts/Layout.astro';
import Divider from '../components/Divider.astro';
import SparklinePattern from '../components/SparklinePattern.astro';
---

<Layout title="Tools" description="Explore SortShelf, IT Logger, CaseLens, and the Evidence Processing Suite — four tools DataForge built to solve real file, ticketing, and legal-discovery problems.">

<!-- ── INTRO BLOCK (accounts for fixed nav) ── -->
<div class="tools-intro-block">
  <SparklinePattern id="tools-sparkline" />
  <div class="tools-intro-inner">
    <div class="section-header fade-up d1">
      <span class="section-num">04</span>
      <h1 class="section-title">BUILT TO SOLVE<br><em>// REAL PROBLEMS</em></h1>
    </div>
    <Divider variant="circuit" />
    <p class="tools-page-intro fade-up d2">
      Tools I built because the problem was real and the solution didn't exist yet.
    </p>
  </div>
</div>

<!-- ── SORTSHELF ── -->
<div style="background: var(--bg); border-bottom: 1px solid var(--border);">
  <div class="section">

    <div class="ss-card reveal">
      <div class="ss-accent-bar"></div>

      <div class="ss-card-top">
        <div class="ss-title-block">
          <div class="ss-eyebrow">// File Organization Utility</div>
          <h2 class="ss-name">SORTSHELF</h2>
          <div class="ss-subtitle">FILE ORGANIZATION UTILITY · WINDOWS · v0.3</div>
          <div class="ss-underline"></div>
        </div>
        <span class="status-live">
          <span class="status-dot"></span>Live
        </span>
      </div>

      <div class="ss-card-body">
        <div class="ss-info">
          <p class="ss-desc">
            Your Downloads folder is chaos. SortShelf scans a target folder, categorizes every
            file by type, previews the moves before anything happens, then sorts with one click.
            Safe by default — dry run mode is always on. One-step undo if you change your mind.
          </p>

          <div class="ss-features-label">Features</div>
          <ul class="ss-features">
            <li>Sorts into 12 categories automatically, including a Misc catch-all</li>
            <li>Preview every move before execution</li>
            <li>Safe by default — nothing moves without approval</li>
            <li>One-step undo</li>
            <li>Watches folders for new files automatically</li>
            <li>Protected path block — never touches your project directories</li>
          </ul>

          <div class="ss-gallery ss-gallery--four">
            <button type="button" class="ss-panel" aria-haspopup="dialog" aria-label="Enlarge screenshot: the empty app" data-caption="App on launch, with dry run on by default">
              <span class="ss-panel-label">APP</span>
              <img class="ss-panel-img" src="/images/tools/sortshelf-01-empty.webp" alt="SortShelf main window on launch, with an empty project list and no source folder selected. A dry run indicator is shown at the bottom." width="1600" height="863" loading="lazy" decoding="async" />
              <span class="ss-panel-cap">App on launch, with dry run on by default</span>
            </button>
            <button type="button" class="ss-panel" aria-haspopup="dialog" aria-label="Enlarge screenshot: the folder before sorting" data-caption="A sample folder of mixed files before sorting">
              <span class="ss-panel-label">BEFORE</span>
              <img class="ss-panel-img" src="/images/tools/sortshelf-02-before.webp" alt="Windows File Explorer showing a folder of about forty mixed files, including documents, spreadsheets, images, scripts and archives, all in one flat list." width="617" height="871" loading="lazy" decoding="async" />
              <span class="ss-panel-cap">A sample folder of mixed files before sorting</span>
            </button>
            <button type="button" class="ss-panel" aria-haspopup="dialog" aria-label="Enlarge screenshot: the dry run preview" data-caption="Dry run previews every move before anything changes">
              <span class="ss-panel-label">PREVIEW</span>
              <img class="ss-panel-img" src="/images/tools/sortshelf-03-preview.webp" alt="SortShelf dry run preview listing each file with its assigned category and a Move action, with a status bar reading 40 files found." width="1600" height="863" loading="lazy" decoding="async" />
              <span class="ss-panel-cap">Dry run previews every move before anything changes</span>
            </button>
            <button type="button" class="ss-panel" aria-haspopup="dialog" aria-label="Enlarge screenshot: the folder after sorting" data-caption="The same folder after sorting: 11 of 12 category folders created, one per file type found">
              <span class="ss-panel-label">AFTER</span>
              <img class="ss-panel-img" src="/images/tools/sortshelf-04-after.webp" alt="Windows File Explorer showing eleven category folders after sorting: Archives, Audio, Code, Documents, Images, Installers, Misc, PDFs, Scripts, Spreadsheets and Video." width="538" height="266" loading="lazy" decoding="async" />
              <span class="ss-panel-cap">The same folder after sorting: 11 of 12 category folders created, one per file type found</span>
            </button>
          </div>

          <div class="ss-actions">
            <a href="/contact/" class="btn-ghost">Inquire About SortShelf →</a>
            <span class="ss-note">Available for direct distribution — contact for details</span>
          </div>
        </div>

      </div>

    </div>

  </div>
</div>

<!-- ── IT LOGGER ── -->
<div style="background: var(--bg2); border-bottom: 1px solid var(--border);">
  <div class="section">

    <div class="ss-card reveal">
      <div class="ss-accent-bar"></div>

      <div class="ss-card-top">
        <div class="ss-title-block">
          <div class="ss-eyebrow">// Internal Tooling</div>
          <h2 class="ss-name">IT LOGGER</h2>
          <div class="ss-subtitle">INTERNAL TICKET TRACKER · PYTHON · FLASK · SQLITE</div>
          <div class="ss-underline"></div>
        </div>
        <span class="status-live">
          <span class="status-dot"></span>Live
        </span>
      </div>

      <div class="ss-card-body">
        <div class="ss-info">
          <p class="ss-desc">
            A lightweight internal ticketing system built for environments that won’t adopt
            enterprise helpdesk software. Logs issues, tracks status, and runs locally with
            zero external dependencies or licensing costs. Built for a law firm’s internal IT support.
          </p>

          <div class="ss-features-label">Features</div>
          <ul class="ss-features">
            <li>Log IT issues with title, category, and description</li>
            <li>Track ticket status — Open, In Progress, Resolved</li>
            <li>Filter and search issue history at a glance</li>
            <li>Lightweight local setup — runs on any machine with Python</li>
            <li>Zero external dependencies or licensing costs</li>
            <li>Built for environments that need a log, not a full helpdesk</li>
          </ul>

          <div class="ss-gallery ss-gallery--single">
            <button type="button" class="ss-panel" aria-haspopup="dialog" aria-label="Enlarge screenshot: the IT Logger dashboard" data-caption="Dashboard with ticket totals, issue type distribution and monthly volume">
              <span class="ss-panel-label">DASHBOARD</span>
              <img class="ss-panel-img" src="/images/tools/itlogger-dashboard.webp" alt="IT Logger dashboard showing total, open and resolved ticket counts and average resolution time, a donut chart of issue types, and a bar chart of monthly ticket volume over six months." width="1600" height="535" loading="lazy" decoding="async" />
              <span class="ss-panel-cap">Dashboard with ticket totals, issue type distribution and monthly volume</span>
            </button>
          </div>

          <div class="ss-footer">
            <div class="ss-tags">
              <span class="tag">Python</span>
              <span class="tag">Flask</span>
              <span class="tag">SQLite</span>
              <span class="tag">Internal Tooling</span>
            </div>
            <span class="ss-note">Internal deployment — Law firm</span>
          </div>
        </div>
      </div>

    </div>

  </div>
</div>

<!-- ── CASELENS ── -->
<div style="background: var(--bg); border-bottom: 1px solid var(--border);">
  <div class="section">

    <div class="ss-card reveal">
      <div class="ss-accent-bar"></div>

      <div class="ss-card-top">
        <div class="ss-title-block">
          <div class="ss-eyebrow">// Legal Tech</div>
          <h2 class="ss-name">CASELENS</h2>
          <div class="ss-subtitle">DOCUMENT REVIEW DESKTOP APP · WINDOWS</div>
          <div class="ss-underline"></div>
        </div>
        <span class="status-dev">
          <span class="status-dot-dev"></span>Internal Deployment
        </span>
      </div>

      <div class="ss-card-body">
        <div class="ss-info">
          <p class="ss-desc">
            A desktop tool for reviewing exported case data — built around message-export
            datasets for legal discovery. CaseLens loads a case file, lets a reviewer browse,
            search, and filter messages, then export findings to CSV without touching the
            source data.
          </p>

          <div class="ss-features-label">Features</div>
          <ul class="ss-features">
            <li>Browse message threads with sender, timestamp, and channel context</li>
            <li>Keyword search across the full case dataset</li>
            <li>Filter results by channel or sender</li>
            <li>Export findings to CSV with metadata headers intact</li>
            <li>Light / dark theme toggle for extended review sessions</li>
            <li>Read-only case states to protect source data from modification</li>
          </ul>

          <div class="ss-footer">
            <div class="ss-tags">
              <span class="tag">Python</span>
              <span class="tag">PyQt6</span>
              <span class="tag">Windows</span>
            </div>
            <span class="ss-note">Internal deployment — Adams Jones Law Firm</span>
          </div>
        </div>
      </div>

    </div>

  </div>
</div>

<!-- ── EVIDENCE PROCESSING SUITE (EPS) ── -->
<div style="background: var(--bg2); border-bottom: 1px solid var(--border);">
  <div class="section">

    <div class="ss-card reveal">
      <div class="ss-accent-bar"></div>

      <div class="ss-card-top">
        <div class="ss-title-block">
          <div class="ss-eyebrow">// Legal Tech · Evidence &amp; Media Processing</div>
          <h2 class="ss-name">EPS</h2>
          <div class="ss-subtitle">EVIDENCE PROCESSING SUITE · WINDOWS</div>
          <div class="ss-underline"></div>
        </div>
        <span class="status-dev">
          <span class="status-dot-dev"></span>Internal Deployment
        </span>
      </div>

      <div class="ss-card-body">
        <div class="ss-info">
          <p class="ss-desc">
            A standalone media processing pipeline for legal evidence — extracts frames from
            video, runs OCR on images and screenshots, generates attorney-ready contact sheets,
            and verifies file integrity with SHA-256 hashing. Built to run on any evidence set,
            independent of CaseLens.
          </p>

          <div class="ss-features-label">Features</div>
          <ul class="ss-features">
            <li>Frame extraction from video evidence, with timestamped output</li>
            <li>OCR text extraction from image and screenshot evidence</li>
            <li>Contact sheet generation — grid-format PDFs for fast attorney review</li>
            <li>Automated pipeline — extract, OCR, package, and verify in one step</li>
            <li>SHA-256 file verification for chain of custody integrity</li>
            <li>Structured evidence PDF packages, formatted for legal use</li>
          </ul>

          <div class="ss-footer">
            <div class="ss-tags">
              <span class="tag">Python</span>
              <span class="tag">PyQt6</span>
              <span class="tag">FFmpeg</span>
              <span class="tag">Tesseract</span>
              <span class="tag">Windows</span>
            </div>
            <span class="ss-note">Internal deployment — Adams Jones Law Firm</span>
          </div>
        </div>
      </div>

    </div>

  </div>
</div>

<!-- ── CTA ── -->
<div class="cta-strip">
  <div class="cta-glow"></div>
  <div class="cta-eyebrow">// Work With Me</div>
  <h2 class="cta-headline">Your Project<br><em>Could Be Next.</em></h2>
  <p class="cta-sub">
    I take on a limited number of engagements at a time. If you have a problem worth solving,
    let's talk scope.
  </p>
  <div class="cta-actions">
    <a href="/contact/" class="btn-primary">Start a Conversation</a>
    <a href="/services/" class="btn-ghost">See What I Build</a>
  </div>
</div>

<!-- ── LIGHTBOX ── -->
<div id="ss-lightbox" class="ss-lightbox" role="dialog" aria-modal="true" aria-hidden="true" aria-label="Screenshot viewer" inert>
  <button type="button" id="ss-lightbox-close" class="ss-lightbox-close" aria-label="Close screenshot">&times;</button>
  <figure class="ss-lightbox-fig">
    <img id="ss-lightbox-img" src="" alt="" class="ss-lightbox-img" />
    <figcaption id="ss-lightbox-cap" class="ss-lightbox-cap"></figcaption>
  </figure>
</div>

</Layout>

<style>
/* ── INTRO BLOCK ── */
.tools-intro-block {
  background: var(--bg);
  border-bottom: 1px solid var(--border);
  padding-top: var(--nav-h);
  position: relative;
  overflow: hidden;
}
.tools-intro-inner {
  position: relative;
  z-index: 2;
  max-width: 1200px;
  margin: 0 auto;
  padding: 72px 48px 72px;
}
.tools-page-intro {
  font-size: 16px;
  line-height: 1.75;
  color: var(--muted);
  max-width: 540px;
}

/* ── SORTSHELF CARD ── */
.ss-card {
  background: var(--bg3);
  border: 1px solid var(--border2);
  position: relative;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.ss-card:hover,
.ss-card:focus-within {
  transform: translateY(-4px);
  box-shadow: 0 18px 34px rgba(0,0,0,0.4);
}
.ss-accent-bar {
  position: absolute; top: 0; left: 0; right: 0;
  height: 2px;
  background: linear-gradient(90deg, var(--accent), var(--accent2) 40%, transparent);
}
.ss-card-top {
  display: flex; align-items: flex-start; justify-content: space-between;
  padding: 36px 40px 0;
}
.ss-eyebrow {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--muted); margin-bottom: 10px;
}
.ss-name {
  font-family: 'Barlow Condensed', sans-serif;
  font-weight: 900; font-size: clamp(56px, 7vw, 88px);
  letter-spacing: -0.01em; text-transform: uppercase;
  color: var(--text); line-height: 0.88;
  margin-bottom: 12px;
}
.ss-subtitle {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--accent);
}
.ss-underline {
  height: 2px; background: var(--accent); width: 0; margin-top: 12px;
  transition: width 0.4s ease;
}
.ss-card:hover .ss-underline,
.ss-card:focus-within .ss-underline { width: 60%; }
/* Touch devices can't hover — show the interaction state by default. */
@media (hover: none) {
  .ss-underline { width: 60%; }
}

.ss-card-body {
  padding: 36px 40px 32px;
}

.ss-desc {
  font-size: 15px; line-height: 1.8; color: var(--muted);
  margin-bottom: 32px; max-width: 520px;
}

.ss-features-label {
  font-family: 'JetBrains Mono', monospace;
  font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--accent); margin-bottom: 16px;
}
.ss-features {
  list-style: none;
  display: flex; flex-direction: column; gap: 10px;
  margin-bottom: 40px;
  /* Matches .ss-desc's reading width — unconstrained, short bullet
     lines trailed off into a wide empty gutter on desktop. */
  max-width: 520px;
}
.ss-features li {
  font-size: 14px; color: var(--muted); line-height: 1.5;
  padding-left: 20px; position: relative;
}
.ss-features li::before {
  content: '—';
  position: absolute; left: 0;
  color: var(--accent);
  font-family: 'JetBrains Mono', monospace; font-size: 10px;
}
.ss-actions {
  display: flex; gap: 14px; align-items: center; flex-wrap: wrap;
  padding-top: 24px;
  border-top: 1px solid var(--border);
}
.ss-footer {
  display: flex; align-items: center; justify-content: space-between;
  gap: 16px; flex-wrap: wrap;
  padding-top: 24px;
  border-top: 1px solid var(--border);
}
.ss-tags { display: flex; flex-wrap: wrap; gap: 6px; }
.ss-note {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--muted2); white-space: nowrap;
}

/* ── GALLERY ── */
.ss-gallery {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: var(--border);
  border-top: 1px solid var(--border);
}
.ss-panel {
  background: var(--bg4);
  border: none;
  cursor: pointer;
  padding: 0;
  display: flex; flex-direction: column;
  text-align: left;
  transition: box-shadow 0.2s;
}
.ss-panel:hover {
  box-shadow: inset 0 0 0 2px rgba(232,146,10,0.45);
}
.ss-panel:focus-visible,
.ss-lightbox-close:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: -2px;
}
.ss-gallery--four { grid-template-columns: repeat(2, 1fr); }
.ss-gallery--four .ss-panel-img {
  height: auto; aspect-ratio: 16 / 10;
  object-fit: cover; object-position: top left;
}
.ss-gallery--single { grid-template-columns: 1fr; margin-bottom: 40px; }
.ss-panel-label {
  display: block;
  font-family: 'JetBrains Mono', monospace;
  font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--accent);
  padding: 10px 16px 8px;
}
.ss-panel-img {
  width: 100%;
  height: 220px;
  object-fit: contain;
  object-position: top left;
  background: var(--bg4);
  display: block;
  border-top: 1px solid var(--border);
}
.ss-gallery--single .ss-panel-img { height: auto; aspect-ratio: 1600 / 535; }
.ss-panel-cap {
  display: block;
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px; letter-spacing: 0.04em; line-height: 1.6;
  color: var(--muted);
  padding: 10px 16px 14px;
  border-top: 1px solid var(--border);
}
.ss-panel--ph { cursor: default; display: flex; flex-direction: column; }
.ss-panel-ph-body {
  flex: 1;
  display: flex; flex-direction: column; gap: 9px;
  padding: 20px 20px 36px;
  position: relative; min-height: 220px; justify-content: center;
  border-top: 1px solid var(--border);
}
.ss-ph-line {
  height: 5px; background: var(--border2); border-radius: 1px;
}
.ss-ph-note {
  position: absolute; bottom: 14px; left: 20px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 9px; letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--muted2);
}

/* ── LIGHTBOX ── */
.ss-lightbox {
  position: fixed; inset: 0; z-index: 1000;
  background: rgba(0,0,0,0.92);
  display: flex; align-items: center; justify-content: center;
  opacity: 0; pointer-events: none;
  transition: opacity 0.2s;
  cursor: pointer;
}
.ss-lightbox.is-open {
  opacity: 1; pointer-events: auto;
}
.ss-lightbox-fig {
  margin: 0; display: flex; flex-direction: column; align-items: center; gap: 12px;
  max-width: 94vw;
}
.ss-lightbox-img {
  max-width: 94vw; max-height: 80vh;
  height: auto;
  display: block;
  border: 1px solid rgba(232,146,10,0.3);
  cursor: default;
}
.ss-lightbox-cap {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px; letter-spacing: 0.06em; line-height: 1.6;
  color: var(--muted); text-align: center;
}
.ss-lightbox-close {
  position: absolute; top: 12px; right: 12px;
  width: 44px; height: 44px;
  background: var(--bg3); color: var(--text);
  border: 1px solid var(--border2);
  font-size: 28px; line-height: 1; cursor: pointer;
}
.ss-lightbox-close:hover { border-color: var(--accent); color: var(--accent); }


/* ── STATUS ── */
.status-live {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 5px 14px;
  background: rgba(34,197,94,0.08);
  border: 1px solid rgba(34,197,94,0.2);
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase;
  color: #4ade80;
  white-space: nowrap; flex-shrink: 0;
}
.status-dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: #4ade80;
  box-shadow: 0 0 6px rgba(74,222,128,0.6);
  animation: pulse-live 2s ease-in-out infinite;
  flex-shrink: 0;
}
@keyframes pulse-live {
  0%, 100% { opacity: 1; }
  50%       { opacity: 0.45; }
}
.status-dev {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 5px 14px;
  background: var(--adim);
  border: 1px solid var(--adim3);
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--accent);
  white-space: nowrap; flex-shrink: 0;
}
.status-dot-dev {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--accent);
  flex-shrink: 0;
}

/* ── CTA STRIP ── */
.cta-strip {
  padding: 100px 48px;
  text-align: center;
  position: relative; overflow: hidden;
  background: var(--bg);
}
.cta-glow {
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%,-50%);
  width: 800px; height: 400px;
  background: radial-gradient(ellipse, rgba(232,146,10,0.06) 0%, transparent 60%);
  pointer-events: none;
}
.cta-eyebrow {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--accent); margin-bottom: 20px;
  position: relative; z-index: 1;
}
.cta-headline {
  font-family: 'Barlow Condensed', sans-serif;
  font-weight: 900; font-size: clamp(48px, 6vw, 80px);
  line-height: 0.92; text-transform: uppercase;
  color: var(--text); margin-bottom: 20px;
  position: relative; z-index: 1;
}
.cta-headline em { font-style: normal; color: var(--accent); display: block; }
.cta-sub {
  font-size: 15px; color: var(--muted); margin-bottom: 44px;
  max-width: 460px; margin-inline: auto; line-height: 1.7;
  position: relative; z-index: 1;
}
.cta-actions {
  display: flex; gap: 16px; justify-content: center;
  align-items: center; flex-wrap: wrap;
  position: relative; z-index: 1;
}

/* ── RESPONSIVE ── */
@media (max-width: 900px) {
  .tools-intro-inner { padding: 56px 24px; }
  .ss-card-top { padding: 28px 24px 0; flex-wrap: wrap; gap: 16px; }
  .ss-card-body { padding: 24px 24px 24px; }
  .ss-gallery, .ss-gallery--four { grid-template-columns: 1fr; }
  .ss-actions { flex-direction: column; align-items: flex-start; }
  .ss-footer { flex-direction: column; align-items: flex-start; }
  .it-card-top { padding: 24px 24px 0; }
  .it-card-body { padding: 20px 24px 28px; flex-direction: column; }
  .cta-strip { padding: 80px 24px; }
}
</style>

<script>
  const panels    = document.querySelectorAll<HTMLButtonElement>('.ss-panel');
  const lightbox  = document.getElementById('ss-lightbox') as HTMLElement;
  const lbImg     = document.getElementById('ss-lightbox-img') as HTMLImageElement;
  const lbCap     = document.getElementById('ss-lightbox-cap') as HTMLElement;
  const lbClose   = document.getElementById('ss-lightbox-close') as HTMLButtonElement;
  let lastTrigger: HTMLElement | null = null;

  function openLightbox(img: HTMLImageElement, caption: string, trigger: HTMLElement) {
    lastTrigger = trigger;
    lbImg.src = img.currentSrc || img.src;
    lbImg.alt = img.alt;
    lbImg.width = img.naturalWidth || Number(img.getAttribute('width'));
    lbImg.height = img.naturalHeight || Number(img.getAttribute('height'));
    lbCap.textContent = caption;
    lightbox.removeAttribute('inert');
    lightbox.setAttribute('aria-hidden', 'false');
    lightbox.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    lbClose.focus();
  }

  function closeLightbox() {
    lightbox.classList.remove('is-open');
    lightbox.setAttribute('aria-hidden', 'true');
    lightbox.setAttribute('inert', '');
    document.body.style.overflow = '';
    lastTrigger?.focus();
    lastTrigger = null;
  }

  panels.forEach(panel => {
    panel.addEventListener('click', () => {
      const img = panel.querySelector('.ss-panel-img') as HTMLImageElement;
      openLightbox(img, panel.dataset.caption || '', panel);
    });
  });

  lbClose.addEventListener('click', closeLightbox);

  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  document.addEventListener('keydown', (e) => {
    if (!lightbox.classList.contains('is-open')) return;
    if (e.key === 'Escape') closeLightbox();
    // Only one focusable control in the dialog — keep Tab inside it.
    if (e.key === 'Tab') { e.preventDefault(); lbClose.focus(); }
  });
</script>
